# ============================================
# Files/folders excluded from `R CMD build`
# Patterns are Perl-style regular expressions
# ============================================

# Claude Code artifacts
^CLAUDE\.md$
^\.claude$
^\.claude-cache$
(^|/)\.claude$
(^|/)\.cc-writes$

# Project documentation (kept in git, but not shipped to CRAN)
^docs$

# Reference implementations carried for porting only (isqg C++, PleioArch R)
^context$

# Python package (separate deliverable, not part of R package)
^python$

# Spec workflow artifacts
^_specs$

# Repo-level config
^CITATION\.cff$
^\.gitignore$
^\.gitattributes$
^\.github$
^\.editorconfig$
^\.vscode$
^\.idea$

# CRAN submission helpers (kept in git but not in bundle)
^cran-comments\.md$
^CRAN-SUBMISSION$
^revdep$

# README sources (the rendered README.md is kept, .Rmd source is not)
^README\.Rmd$
^README_files$

# Build artifacts
^.*\.Rproj$
^\.Rproj\.user$
^.*\.tar\.gz$
^.*\.Rcheck$

# Rust build artifacts (anywhere in tree)
^.*/target$
^src/rust/target$

# OS junk
^.*\.DS_Store$
^\.DS_Store$

# CI / dev config
^codecov\.yml$
^\.codecov\.yml$
^appveyor\.yml$
^\.travis\.yml$

# Vignette source artifacts (final .html ships, intermediates don't)
^vignettes/.*_cache$
^vignettes/.*\.utf8\.md$
^vignettes/.*\.knit\.md$
^src/\.cargo$
^src/rust/vendor$
^src/Makevars$
^src/Makevars\.win$

# Development benchmarks (not user-facing)
^benchmarks$

# Dataset-generation scripts (kept in git; the built data/ ships instead)
^data-raw$

# Stray intermediate GDS files written by tests/conversions.
# Cleaned in tests/testthat/setup.R; guarded here in case any linger at build time.
^tests/testthat/file.*\.gds$
^file.*\.gds$
^tests/test_numeric\.txt$

# Large local-only as_numeric fixtures, 76MB and untracked. Tests that use them
# skip when absent, so the bundle stays small.
^tests/SNP55K_maize282_AGPv2.*$

# Dev-only top-level files (kept in git, not shipped to CRAN)
^LICENSE\.md$
^TODO\.md$
^TODO_newfeatures\.md$
^_config\.yml$
^SP_logo\.png$
^data-raw$

# Purled vignette scripts and rendered HTML: build artifacts that would
# otherwise ship stale copies of the vignette code.
^vignettes/.*\.R$
^vignettes/.*\.html$
^Rplots\.pdf$
^REVIEW_GUIDE\.md$
