{
  "chapters": [
    {
      "id": "first",
      "title": "A first simulation",
      "scope": "Bring your own genotypes, observed maize example, diagnostics, export, and reproducibility",
      "status": "Pilot draft"
    },
    {
      "id": "conventions",
      "title": "Notation and conventions",
      "scope": "Coding, scales, objects, identifiers, and replication",
      "status": "Pilot draft"
    },
    {
      "id": "input",
      "title": "Genotype input and quality control",
      "scope": "File formats, allele orientation, missingness, filtering, and LD",
      "status": "Draft; Fable-reviewed, Codex review pending"
    },
    {
      "id": "founders",
      "title": "Maps, haplotypes, and founders",
      "scope": "Population input, synthetic maps, coalescent founders, and haplotype access",
      "status": "Draft; Fable-reviewed, Codex review pending"
    },
    {
      "id": "additive",
      "title": "Additive phenotype models",
      "scope": "Layer effects, causal loci, scaling, and additive diagnostics",
      "status": "Draft; Fable-reviewed, Codex review pending"
    },
    {
      "id": "nonadditive",
      "title": "Dominance and epistasis",
      "scope": "Coding, orthogonal models, interacting loci, and variance components",
      "status": "Draft; Fable-reviewed, Codex review pending"
    },
    {
      "id": "multitrait",
      "title": "Pleiotropy, linkage, and multiple traits",
      "scope": "Architectures, feasible correlations, partial sharing, and residual correlation",
      "status": "Draft; Fable-reviewed, Codex review pending"
    },
    {
      "id": "binary",
      "title": "Binary phenotypes with human genotypes",
      "scope": "Human genotype input, liability thresholds, prevalence, liability and observed scales, and case/control sampling interpretation",
      "status": "Draft; Fable-reviewed, Codex review pending"
    },
    {
      "id": "complex",
      "title": "Complex phenotype architectures",
      "scope": "vQTL and combined simulations",
      "status": "Draft; Fable-reviewed, Codex review pending"
    },
    {
      "id": "cross",
      "title": "Meiosis and crossing",
      "scope": "Crossing, selfing, doubled haploids, pedigree, and family access",
      "status": "Draft; Fable-reviewed, Codex review pending"
    },
    {
      "id": "trait",
      "title": "Trait values across generations",
      "scope": "Fixed effects, reference scales, environments, and phenotyping",
      "status": "Draft; Fable-reviewed, Codex review pending"
    },
    {
      "id": "mating",
      "title": "Mating designs and crossbreeding",
      "scope": "Planned matings, ancestry composition, and heterosis",
      "status": "Draft; Fable-reviewed, Codex review pending"
    },
    {
      "id": "prediction",
      "title": "Relationship matrices and prediction",
      "scope": "Animal-data worked examples: pedigree and genomic relationships, single- and multi-trait BLUP, accuracy",
      "status": "Draft; Fable-reviewed, Codex review pending"
    },
    {
      "id": "selection",
      "title": "Individual, family, and multivariate selection",
      "scope": "Truncation, family methods, indices, culling, BQP, and random controls",
      "status": "Draft; Fable-reviewed, Codex review pending"
    },
    {
      "id": "optimization",
      "title": "Contributions and cross usefulness",
      "scope": "OCS objectives, coancestry constraints, allocation, and usefulness",
      "status": "Draft; Fable-reviewed, Codex review pending"
    },
    {
      "id": "markers",
      "title": "Marker-assisted breeding",
      "scope": "Gene pyramiding, foreground and background selection, recovery",
      "status": "Draft; Fable-reviewed, Codex review pending"
    },
    {
      "id": "programs",
      "title": "Combining ability and breeding schemes",
      "scope": "Testcrosses, progeny tests, repeated selection, and population management",
      "status": "Draft; Fable-reviewed, Codex review pending"
    },
    {
      "id": "expression",
      "title": "Transcriptome simulation and counts",
      "scope": "Expression generation, mimic calibration, and count observations",
      "status": "Draft; Fable-reviewed, Codex review pending"
    },
    {
      "id": "mediation",
      "title": "Expression-mediated phenotypes",
      "scope": "Expression layers and genetic/environmental mediation summaries",
      "status": "Draft; Fable-reviewed, Codex review pending"
    },
    {
      "id": "output",
      "title": "Inspecting and exporting results",
      "scope": "Long/wide tables, plots, QTN metadata, text/JSON and split-marker exports",
      "status": "Draft; Fable-reviewed, Codex review pending"
    },
    {
      "id": "legacy",
      "title": "Legacy interface and migration",
      "scope": "Frozen create_phenotypes interface, independent theory, and migration",
      "status": "Draft; Fable-reviewed, Codex review pending"
    }
  ],
