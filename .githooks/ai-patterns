# ai-patterns — the ONE definition of "AI/assistant attribution" (AGENTS.md rule #1).
# Sourced (never executed) by BOTH .githooks/commit-msg (local) and
# .github/workflows/attribution-guard.yml (server), so the two cannot drift.
# Regression tests: dev/test-attribution-guard.sh  (>= 30 sample messages).
#
# POSIX ERE, applied with `grep -iE`.
#
# AI/assistant names. Deliberately NOT included: any generic noreply.github.com address
# (a human GitHub co-author may use one); AI bots are caught by their NAME instead
# (e.g. "Copilot@users.noreply.github.com" contains "copilot").
AI_NAMES='claude|anthropic|codex|openai|chatgpt|\bgpt-?[0-9]|\bgpt\b|copilot|gemini|\bcursor\b|windsurf|codeium|\baider\b|\bllm\b|\bai\b|bot@|noreply@anthropic'

# A trailer-style line whose key ends in "-by" / "-with" / "-using" / "-via", e.g.
# Co-Authored-By, Generated-by, Assisted-by, Reviewed-by, Signed-off-by, Made-with.
# Any such trailer that names an AI is rejected. Leading whitespace / quote marks allowed.
AI_TRAILER_KEY='^[[:space:]>]*[A-Za-z][A-Za-z-]*-(by|with|using|via)[[:space:]]*:'

# "<verb> ... with|by|using|via ... <AI name>" signature lines (e.g. "Generated with
# [Claude Code]", "Generated by GitHub Copilot", "Made with Claude", "Written using GPT-4"),
# the robot-signature emoji, and "generated with AI". Requires an AI name on the same
# line, so ordinary prose that merely says "generated by hand" is fine.
AI_GEN_VERBS='generated|made|created|written|authored|produced|drafted|composed|assisted|co-?authored|powered'
AI_GEN="\\b($AI_GEN_VERBS)\\b[^.]{0,60}\\b(with|by|using|via)\\b[^.]{0,40}($AI_NAMES|\\ba\\.?i\\b)|🤖"

# ai_attribution_scan  < message-text
#   Prints one "<reason>: <offending line>" per violation; returns 1 if any, else 0.
ai_attribution_scan() {
  local line hit=0
  while IFS= read -r line || [ -n "$line" ]; do
    [ -z "$line" ] && continue
    if printf '%s' "$line" | grep -qiE "$AI_TRAILER_KEY" &&
       printf '%s' "$line" | grep -qiE "$AI_NAMES"; then
      printf 'AI/assistant trailer: %s\n' "$line"; hit=1; continue
    fi
    if printf '%s' "$line" | grep -qiE "$AI_GEN"; then
      printf "AI 'generated with/by <assistant>' attribution: %s\n" "$line"; hit=1
    fi
  done
  return "$hit"
}
