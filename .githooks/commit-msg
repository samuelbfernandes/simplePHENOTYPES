#!/usr/bin/env bash
# commit-msg — reject any AI/assistant co-author or "generated with/by" attribution.
# Non-negotiable project rule (AGENTS.md #1 / docs/constitution): commits read as a
# human wrote them. An AI co-author trailer once registered the assistant as a GitHub
# collaborator — this hook makes that impossible to commit, whichever model wrote it.
# The patterns live in ONE file, .githooks/ai-patterns, shared with the CI guard.
#
# Installed via: git config core.hooksPath .githooks   (see dev/setup.sh)
set -euo pipefail

msg_file="$1"
# shellcheck source=.githooks/ai-patterns
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ai-patterns"

# Strip comment lines (git's own '#'-prefixed template) before scanning.
body="$(grep -v '^#' "$msg_file" || true)"

if ! hits="$(printf '%s\n' "$body" | ai_attribution_scan)"; then
  echo "✖ commit blocked: AI/assistant attribution is not allowed" >&2
  printf '%s\n' "$hits" | sed 's/^/  offending: /' >&2
  echo "  Remove the attribution and commit again (AGENTS.md rule #1)." >&2
  exit 1
fi
exit 0
