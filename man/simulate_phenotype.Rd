data("SNP55K_maize282_maf04")
# piped form
ph <- simulate_phenotype(SNP55K_maize282_maf04, seed = 1)
ph <- additive(ph, prop = 0.5, n_qtn = 3)
# one-call form
ph2 <- simulate_phenotype(SNP55K_maize282_maf04, h2 = 0.5, n_qtn = 3, seed = 1)
}
